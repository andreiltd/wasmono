wasm_plug(name = "inline_registry", socket_registry = "test:socket@1.2.3", plugs_registry = ["test:plug@1.2.3"])
wasm_package(name = "unpinned_package", package = "test:package")
wasm_package(name = "version_range", package = "test:package@^1.2.3")
wasm_package(name = "invalid_digest", package = "test:package@1.2.3", expected_sha256 = "invalid")

# These package declarations are only analyzed; no registry access is needed.
wasm_package(name = "pinned_package", package = "test:package@1.2.3")
wasm_package(name = "prerelease_package", package = "test:package@1.2.3-rc.1+fixture")
wasm_package(name = "digest_pinned_package", package = "test:package", expected_sha256 = "0" * 64)
wasm_package(name = "explicitly_unpinned_package", package = "test:package", allow_unpinned = True)

